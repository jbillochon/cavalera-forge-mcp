# forge.cavalera.news - public MCP connector Cavalera Forge.
# Proxies /mcp, /health and the OAuth facade to 127.0.0.1:8793, publishes the
# two databases under /data/ for local installs; the rest is 404,
# / redirects to the project page.
server {
    listen 80;
    listen [::]:80;
    server_name forge.cavalera.news;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html;
        try_files $uri =404;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name forge.cavalera.news;

    ssl_certificate /etc/letsencrypt/live/forge.cavalera.news/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/forge.cavalera.news/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    include /etc/nginx/snippets/cavalera-securite.conf;
    access_log /var/log/nginx/forgemcp.log;
    client_max_body_size 64k;
    limit_req_status 429;

    location = /mcp {
        limit_req zone=forgemcp burst=60 nodelay;
        proxy_pass http://127.0.0.1:8793/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
    location = /health {
        limit_req zone=forgemcp burst=20 nodelay;
        proxy_pass http://127.0.0.1:8793/health;
        proxy_set_header Host $host;
    }
    # OAuth facade for claude.ai custom connectors.
    location ~ ^/(\.well-known/(oauth-protected-resource(/mcp)?|oauth-authorization-server|openid-configuration)|jwks|register|authorize|token)$ {
        limit_req zone=forgemcp burst=20 nodelay;
        proxy_pass http://127.0.0.1:8793;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # Published databases for local installs (exact files the server reads).
    location ~ ^/data/(craft|market)\.db$ {
        limit_req zone=forgedata burst=4 nodelay;
        root /var/www/forge-data;
        default_type application/vnd.sqlite3;
        add_header Cache-Control "public, max-age=3600" always;
        include /etc/nginx/snippets/cavalera-securite.conf;
    }
    location = / {
        return 302 https://github.com/jbillochon/cavalera-forge-mcp;
    }
    location / {
        return 404;
    }
}
